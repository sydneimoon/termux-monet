    <!-- Features Section -->
    <section class="features" id="features">
        <div class="container">
            <div class="section-header">
                <h2 class="section-title">Powerful <span class="gradient-text">Features</span></h2>
                <p class="section-subtitle">Everything the regular Termux gives you, plus a Material You touch</p>
            </div>
            <div class="features-grid">
                <div class="feature-card" data-aos="fade-up">
                    <div class="feature-icon">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5" />
                        </svg>
                    </div>
                    <h3 class="feature-title">Material You Theming</h3>
                    <p class="feature-description">A dynamic Monet color scheme powered by your wallpaper. On Android
                        12+ the app follows Material You, while lower versions show a static black and white theme.</p>
                </div>
                <div class="feature-card" data-aos="fade-up" data-aos-delay="100">
                    <div class="feature-icon">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z" />
                        </svg>
                    </div>
                    <h3 class="feature-title">Experimental Features</h3>
                    <p class="feature-description">A playground of community-made changes and experimental patches on top
                        of Termux. Don't expect consistency, professionality or stability.</p>
                </div>
                <div class="feature-card" data-aos="fade-up" data-aos-delay="200">
                    <div class="feature-icon">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M18 8h1a4 4 0 010 8h-1M2 8h16v9a4 4 0 01-4 4H6a4 4 0 01-4-4V8z" />
                            <line x1="6" y1="1" x2="6" y2="4" />
                            <line x1="10" y1="1" x2="10" y2="4" />
                            <line x1="14" y1="1" x2="14" y2="4" />
                        </svg>
                    </div>
                    <h3 class="feature-title">Phantom Process Fixes</h3>
                    <p class="feature-description">Guidance to tame the Android Phantom Process Killer on Android 12+
                        via ADB, root or a Magisk module, so Termux stops being killed silently.</p>
                </div>
                <div class="feature-card" data-aos="fade-up" data-aos-delay="300">
                    <div class="feature-icon">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M4 17l6-6-6-6M12 19h8" />
                        </svg>
                    </div>
                    <h3 class="feature-title">Nightly &amp; Stable Builds</h3>
                    <p class="feature-description">Stabler releases from GitHub Releases and bleeding-edge unstable
                        APKs from GitHub Actions, built for every push to the repository.</p>
                </div>
                <div class="feature-card" data-aos="fade-up" data-aos-delay="400">
                    <div class="feature-icon">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M19 21l-7-5-7 5V5a2 2 0 012-2h10a2 2 0 012 2z" />
                        </svg>
                    </div>
                    <h3 class="feature-title">Terminal Customization</h3>
                    <p class="feature-description">Day/night color theme prefixes, true italic fonts, wallpaper support
                        with overlay colors and optional background images — your terminal, your style.</p>
                </div>
                <div class="feature-card" data-aos="fade-up" data-aos-delay="500">
                    <div class="feature-icon">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <polyline points="4 17 10 11 4 5" />
                            <line x1="12" y1="19" x2="20" y2="19" />
                        </svg>
                    </div>
                    <h3 class="feature-title">Dynamic MOTD &amp; Images</h3>
                    <p class="feature-description">Standard and dynamic message-of-the-day, plus inline images and gifs
                        using the Sixel and iTerm2 protocols right inside the terminal.</p>
                </div>
            </div>
            <div class="features-extra">
                <div class="extra-feature">
                    <span class="extra-icon">🔤</span>
                    <span>Disable text scaling</span>
                </div>
                <div class="extra-feature">
                    <span class="extra-icon">🌗</span>
                    <span>Day / Night themes</span>
                </div>
                <div class="extra-feature">
                    <span class="extra-icon">🅸</span>
