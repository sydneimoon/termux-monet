    <!--  ¡ design.3 !  -->
    <LinearLayout
        android:id="@+id/header_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        android:orientation="vertical"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="3dp"
            android:paddingStart="3dp"
            android:text="SYSADMIN"
            android:textSize="14sp"
            android:textColor="#ff323232"
            android:background="@drawable/color_shape" />

        <FrameLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">

            <com.termux.view.GradientBorderView
                android:layout_width="wrap_content"
                android:layout_height="64dp" />

            <com.termux.view.MatrixView
                android:layout_width="wrap_content"
                android:layout_height="60dp"
                android:layout_margin="2dp"
                android:background="@android:color/transparent" />

            <!--<me.ibrahimsn.particle.ParticleView
                android:id="@+id/particleView"
                android:layout_width="wrap_content"
                android:layout_height="60dp"
                android:layout_margin="2dp"
                android:background="@android:color/transparent"
                android:alpha="0.6"
                app:particleCount="6"
                app:particleMinRadius="3"
                app:particleMaxRadius="9"
                app:particlesBackgroundColor="#0023262a"
                app:particleColor="#656565"
                app:particleLineColor="#656565"
                app:particleLinesEnabled="true"/>-->

            <pl.droidsonroids.gif.GifImageView
                android:layout_width="90dp"
                android:layout_height="50dp"
                android:layout_marginHorizontal="10dp"
                android:layout_gravity="center_vertical|right"
                android:gravity="center"
                android:src="@drawable/src_dragon" />

            <TextView
                android:id="@+id/header_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal|top"
                android:text="&lt;TERMUX SYSTEM/&gt;"
                android:textSize="15sp"
                android:textColor="#cecece"
                android:textStyle="bold"
                android:layout_marginTop="15dp" />

            <com.tomer.fadingtextview.FadingTextView
                android:id="@+id/fadingTextView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal|bottom"
                android:textSize="14sp"
                android:textColor="#858585"
                android:layout_marginBottom="15dp" />

            <!--<TextView
                android:id="@+id/header_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal|bottom"
                android:text="SimplyTheBest"
                android:textSize="14sp"
                android:textColor="#a5a5a5"
                android:layout_marginBottom="15dp" />-->
        </FrameLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/header_terminal_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="3dp"
            android:paddingStart="3dp"
            android:text="DARK TERMINAL"
            android:textSize="14sp"
            android:textColor="#ff323232"
            android:background="@drawable/color_shape" />
    </LinearLayout>

    <RelativeLayout
        android:id="@+id/activity_termux_root_relative_layout"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginHorizontal="0dp"
        android:layout_marginVertical="0dp"
        android:orientation="vertical">

        <!--android:padding="2dp"
        android:orientation="vertical"
        android:background="@drawable/border_shape">-->

        <!--<com.termux.view.MatrixView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="2dp"
            android:background="@android:color/transparent"
            android:alpha="0.3" />-->

        <!--<me.ibrahimsn.particle.ParticleView
            android:id="@+id/particleView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="2dp"
            android:background="@android:color/transparent"
            android:alpha="0.6"
            app:particleCount="6"
            app:particleMinRadius="3"
            app:particleMaxRadius="9"
            app:particlesBackgroundColor="#0023262a"
            app:particleColor="#656565"
            app:particleLineColor="#656565"
            app:particleLinesEnabled="true"/>-->

        <androidx.drawerlayout.widget.DrawerLayout
            android:id="@+id/drawer_layout"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_alignParentTop="true"
            android:layout_above="@+id/terminal_toolbar_view_pager">

            <View
                android:id="@+id/terminal_monetbackground"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@color/background_accent"/>

            <com.termux.view.TerminalView
                android:id="@+id/terminal_view"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:defaultFocusHighlightEnabled="false"
                android:focusableInTouchMode="true"
                android:layout_marginRight="3dp"
                android:layout_marginLeft="3dp"
                android:overScrollMode="never"
                android:smoothScrollbar="false"
                android:scrollingCache="true"
                android:fastScrollEnabled="false"
                android:scrollbarThumbVertical="@drawable/terminal_scroll_shape"
                android:scrollbars="vertical"
                tools:ignore="UnusedAttribute" />
                <!--android:background="@drawable/border_shape" />-->

            <RelativeLayout
                android:layout_width="240dp"
                android:layout_height="match_parent"
                android:layout_gravity="end"
                android:orientation="vertical">

                <com.termux.app.CustomShapeBlurView
                    android:id="@+id/sessions_backgroundblur"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginTop="4dp"
                    android:layout_marginHorizontal="4dp"
                    app:realtimeBlurRadius="15dp"
                    app:realtimeOverlayColor="@android:color/transparent" />

                <View
                    android:id="@+id/sessions_background"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginTop="4dp"
                    android:layout_marginHorizontal="4dp"/>

                <LinearLayout
                    android:id="@+id/left_drawer"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginTop="4dp"
                    android:layout_marginHorizontal="4dp"
                    android:layout_gravity="end"
                    android:orientation="vertical"
                    android:background="@android:color/transparent"
                    android:choiceMode="singleChoice"
                    android:divider="@android:color/transparent"
                    android:dividerHeight="0dp"
                    android:descendantFocusability="blocksDescendants">

                    <include layout="@layout/drawer_header" />

                    <ListView
                        android:id="@+id/terminal_sessions_list"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:layout_gravity="top"
                        android:choiceMode="singleChoice"
                        android:divider="@android:color/transparent"
                        android:longClickable="true" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:orientation="vertical">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/change_background_button"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:text=" Wallpaper "
                            android:textColor="#BABABA"
                            app:backgroundTint="#CC1B242F"
                            app:rippleColor="@color/drawer_ripple_color"
                            app:icon="@drawable/ic_image_search"
                            app:iconTint="#5ce6ff" />

                    </LinearLayout>

                    <LinearLayout
                        style="?android:attr/buttonBarStyle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:orientation="horizontal">

                        <ImageView
                            android:id="@+id/toggle_keyboard_button"
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:layout_marginTop="10dp"
                            android:layout_marginBottom="10dp"
                            android:layout_marginHorizontal="16dp"
                            android:src="@drawable/ic_keyboard2"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            app:tint="#454545"
                            android:contentDescription="@string/action_toggle_soft_keyboard"/>

                        <ImageView
                            android:id="@+id/new_session_button"
                            android:layout_width="45dp"
                            android:layout_height="45dp"
                            android:layout_marginTop="10dp"
                            android:layout_marginBottom="10dp"
                            android:layout_marginHorizontal="16dp"
                            android:src="@drawable/ic_new_session"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            app:tint="#7abbff"
                            android:contentDescription="@string/action_new_session"/>

                        <ImageView
                            android:id="@+id/settings_button"
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:layout_marginTop="10dp"
                            android:layout_marginBottom="10dp"
                            android:layout_marginHorizontal="16dp"
                            android:src="@drawable/ic_settings2"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            app:tint="#454545"
                            android:contentDescription="@string/action_open_settings"/>

                    </LinearLayout>
                </LinearLayout>
            </RelativeLayout>
        </androidx.drawerlayout.widget.DrawerLayout>

        <com.termux.app.CustomShapeBlurView
            android:id="@+id/extrakeys_backgroundblur"
            android:layout_width="match_parent"
            android:layout_height="37.5dp"
            android:layout_alignParentBottom="true"
            android:layout_marginHorizontal="4dp"
            android:layout_marginBottom="4dp"
            app:realtimeBlurRadius="15dp"
            app:realtimeOverlayColor="@android:color/transparent" />

        <View
            android:id="@+id/extrakeys_background"
            android:layout_width="match_parent"
            android:layout_height="37.5dp"
            android:layout_alignParentBottom="true"
            android:layout_marginHorizontal="4dp"
            android:layout_marginBottom="4dp" />

        <!--<TextView
            android:id="@+id/terminal_text_footer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="75dp"
            android:layout_centerHorizontal="true"
            android:layout_alignParentBottom="true"
            android:text="i rOOck you"
            android:textColor="#454545"
            android:textSize="12sp" />-->

        <androidx.viewpager.widget.ViewPager
            android:id="@+id/terminal_toolbar_view_pager"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="37.5dp"
            android:layout_alignParentBottom="true"
            android:layout_marginTop="4dp"
            android:layout_marginHorizontal="4dp"
            android:layout_marginBottom="4dp"
            android:background="@android:color/transparent"/>
            <!--android:background="@drawable/border_shape" />-->

        <com.termux.view.GradientBorderView
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

    </RelativeLayout>

    <View
        android:id="@+id/activity_termux_bottom_space_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:background="@android:color/transparent" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:orientation="vertical">

        <!--<com.termux.app.AnimatedGradientView
            android:layout_width="match_parent"
            android:layout_height="4dp" />-->

        <!--<View
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:background="@drawable/color_shape" />-->

        <View
            android:layout_width="match_parent"
            android:layout_height="0dp" />

    </LinearLayout>

</com.termux.app.terminal.TermuxActivityRootView>
